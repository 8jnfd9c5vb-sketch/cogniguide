# Local profile: Ollama on this machine. No notes leave the iMac.
# Pull the models first:
#   ollama pull qwen2.5vl:3b
#   ollama pull qwen3:4b-instruct-2507-q4_K_M
#   ollama pull bge-m3
DASHSCOPE_BASE_URL=http://127.0.0.1:11434/v1

# Ollama ignores the key but the client needs a non-empty one.
DASHSCOPE_API_KEY=ollama

# Vision runs once per PDF page. On 8 GB memory expect minutes, not seconds.
VISION_MODEL=qwen2.5vl:3b
# The plain qwen3:4b tag is a reasoning model; it spent minutes thinking and blew the
# client timeout. This non-thinking refresh answers directly.
CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBEDDING_MODEL=bge-m3
